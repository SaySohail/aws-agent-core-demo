{
  "name": "@agent-launchpad/aws",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/**/*.test.ts",
    "clean": "tsc --build --clean"
  },
  "dependencies": {
    "@agent-launchpad/schemas": "workspace:*",
    "@aws-sdk/client-dynamodb": "3.969.0",
    "@aws-sdk/client-bedrock-agentcore": "3.1106.0",
    "@aws-sdk/client-s3": "3.969.0",
    "@aws-sdk/client-sts": "3.969.0",
    "@aws-sdk/lib-dynamodb": "3.969.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "tsx": "4.20.6"
  }
}
