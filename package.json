{
  "name": "agent-launchpad",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "22.x",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "dev": "pnpm --filter @agent-launchpad/web dev",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "build": "pnpm -r --if-present --workspace-concurrency=1 build",
    "synth": "pnpm --filter @agent-launchpad/customer-bootstrap-infrastructure synth && pnpm --filter @agent-launchpad/agent-template-infrastructure synth && pnpm --filter @agent-launchpad/control-plane-infrastructure synth",
    "validate:security": "pnpm test && pnpm --filter @agent-launchpad/customer-bootstrap-infrastructure test && pnpm --filter @agent-launchpad/agent-template-infrastructure test",
    "validate:aws-e2e": "node scripts/validate-aws-e2e.mjs",
    "clean": "pnpm -r --if-present clean"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.3.0",
    "@astryxdesign/core": "^0.3.0",
    "@astryxdesign/theme-neutral": "^0.3.0",
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.0",
    "aws-cdk": "2.1135.1",
    "esbuild": "0.28.1",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0"
  }
}
