{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@agent-launchpad/schemas": ["packages/schemas/src/index.ts"],
      "@agent-launchpad/shared": ["packages/shared/src/index.ts"],
      "@agent-launchpad/aws": ["packages/aws/src/index.ts"]
    }
  }
}
