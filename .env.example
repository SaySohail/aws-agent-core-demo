# Copy to apps/web/.env.local for local web development. Never commit populated environment files.
NODE_ENV=development
CONTROL_API_PORT=4000
AWS_REGION=us-east-1

# Cognito values are emitted by the control-plane CDK stack outputs.
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/example-pool-id
COGNITO_CLIENT_ID=example-browser-client-id
COGNITO_DOMAIN=https://example.auth.us-east-1.amazoncognito.com
APP_ORIGIN=http://localhost:3000

# Explicit browser origins are required when synthesizing each control-plane environment.
CONTROL_PLANE_DEV_WEB_ORIGIN=http://localhost:3000
CONTROL_PLANE_DEV_WEB_ORIGINS=http://localhost:3000
CONTROL_PLANE_PROD_WEB_ORIGIN=https://app.example.com
CONTROL_PLANE_PROD_WEB_ORIGINS=https://app.example.com
