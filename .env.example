# Copy to apps/web/.env.local for local web development. Never commit populated environment files.
NODE_ENV=development
CONTROL_API_PORT=4000
AWS_REGION=eu-west-2

# Cognito values are emitted by the control-plane CDK stack outputs.
COGNITO_ISSUER=https://cognito-idp.eu-west-2.amazonaws.com/example-pool-id
COGNITO_CLIENT_ID=example-browser-client-id
COGNITO_DOMAIN=https://example.auth.eu-west-2.amazoncognito.com
APP_ORIGIN=http://localhost:3000

# Explicit browser origins are required when synthesizing each control-plane environment.
CONTROL_PLANE_DEV_WEB_ORIGIN=http://localhost:3000
CONTROL_PLANE_DEV_WEB_ORIGINS=http://localhost:3000
CONTROL_PLANE_PROD_WEB_ORIGIN=https://app.example.com
CONTROL_PLANE_PROD_WEB_ORIGINS=https://app.example.com

# SAY-107 disposable AWS E2E gate. Keep values in CI secrets, never in a browser env file.
# The runner accepts no ambient target account: it assumes these exact bootstrap role ARNs and
# verifies GetCallerIdentity against the corresponding IDs before it calls AgentCore.
AGENT_LAUNCHPAD_AWS_E2E=DESTROY_DISPOSABLE_RESOURCES
AWS_E2E_CUSTOMER_ACCOUNT_A_ID=123456789012
AWS_E2E_BOOTSTRAP_ROLE_A_ARN=arn:aws:iam::123456789012:role/AgentLaunchpadBootstrap
AWS_E2E_EXTERNAL_ID_A=replace-with-connection-a-external-id
# Configure B for real cross-account isolation. Without it, the report is NOT READY.
AWS_E2E_CUSTOMER_ACCOUNT_B_ID=210987654321
AWS_E2E_BOOTSTRAP_ROLE_B_ARN=arn:aws:iam::210987654321:role/AgentLaunchpadBootstrap
AWS_E2E_EXTERNAL_ID_B=replace-with-connection-b-external-id
# A separate, already-revoked disposable role; its AssumeRole must fail.
AWS_E2E_REVOKED_BOOTSTRAP_ROLE_A_ARN=arn:aws:iam::123456789012:role/AgentLaunchpadRevoked
AWS_E2E_REGIONS=eu-west-2
# Explicit control-plane target. The release runner refuses ambient credentials and refuses stages
# other than this declared disposable environment.
AWS_E2E_CONTROL_PLANE_ACCOUNT_ID=123456789012
AWS_E2E_STAGE=dev
